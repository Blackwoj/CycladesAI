# CycladesAI — klucze API do agentów LLM
# Skopiuj ten plik jako .env i uzupełnij klucze:
#   cp .env.example .env
#
# Plik .env jest ignorowany przez git (.gitignore zawiera .env).

# ── Anthropic (Claude) ─────────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── OpenAI (GPT) ───────────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Google Gemini ──────────────────────────────────────────────────────────
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...

# ── Qwen (Alibaba DashScope) ───────────────────────────────────────────────
# https://dashscope.console.aliyun.com/apiKey
# Używany przez OpenAILLMAgent z base_url="https://dashscope.aliyuncs.com/compatible-mode/v1"
QWEN_API_KEY=sk-...

# ── MiniMax ────────────────────────────────────────────────────────────────
# https://platform.minimaxi.com/user-center/basic-information/interface-key
# Używany przez OpenAILLMAgent z base_url="https://api.minimax.chat/v1"
MINIMAX_API_KEY=...

# ── Ollama (lokalny LLaMA / Mistral) ──────────────────────────────────────
# Brak klucza — serwer lokalny. Domyślny host: http://localhost:11434
# Zainstaluj i uruchom: https://ollama.com
# ollama pull llama3.2
# ollama serve
# OLLAMA_HOST=http://localhost:11434
